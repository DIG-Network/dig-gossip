# Node (local tooling; install with npm install)
/node_modules/

# Build artifacts
/target/

# Local coverage reports (cargo llvm-cov) — CI generates and uploads these; never commit locally
# generated copies.
/lcov.info

# IDE
.idea/
.vscode/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Repomix context packs (local only)
.repomix/

# GitNexus index (local only)
.gitnexus/

# SocratiCode (Docker-managed, local only)
.socraticode/

# Claude Code local settings & worktrees
.claude/settings.local.json
.claude/worktrees/

# Transient prompt notes (local only)
docs/prompt/chat.md

# gitnexus writes agent-tooling files into the repository it indexes. They are
# development-loop private and must never be tracked here.
# CLAUDE.md is intentionally NOT ignored: this repo authors its own. Always run
# `gitnexus analyze --skip-agents-md` here, or it re-injects its section into it.
/AGENTS.md
/.claude/skills/gitnexus/
/.claude/skills/generated/
/.gitnexus/
